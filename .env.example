# Postgres (Supabase). Use a "Connection string" no modo "Transaction" (pooled) para DATABASE_URL
# e o modo "Session" (direto, porta 5432) para DIRECT_URL, conforme exige o Prisma + Supabase.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# API do Claude — necessária a partir do Sprint 02 (Interview Engine).
# Gere uma chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
# Opcional — só defina se quiser trocar o modelo padrão (claude-sonnet-5)
# ANTHROPIC_MODEL="claude-sonnet-5"

# API do Apify — necessária a partir do Sprint 04 (Apify Adapter).
# Gere um token em https://console.apify.com/settings/integrations
APIFY_TOKEN="apify_api_..."
